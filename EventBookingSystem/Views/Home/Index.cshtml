@model IEnumerable<EventBookingSystem.Models.Event>
@{
    ViewData["Title"] = "Upcoming Events";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Event Booking System</h1>
    <p>Browse our upcoming events below.</p>
</div>

<div class="row mt-5">
    @if (Model != null && Model.Any())
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@(string.IsNullOrEmpty(ev?.image_url) ? Url.Content("~/images/default-event.png") : ev.image_url)" 
                         class="card-img-top" 
                         alt="@(ev?.title ?? "Event") image"
                         style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@ev?.title</h5>
                        <p class="card-text">
                            <small class="text-muted">
                                @(ev?.date.ToString("dddd, dd MMMM yyyy") ?? "Date TBA") 
                                at @(ev?.date.ToString("hh:mm tt") ?? "Time TBA")
                            </small>
                        </p>
                        <p class="card-text">@ev?.location</p>
                        <p class="card-text mt-auto">
                            <strong>Seats Available:</strong> @ev?.available_seats
                        </p>
                        <a asp-controller="Booking" asp-action="Create" asp-route-id="@ev?.event_id" 
                           class="btn btn-primary mt-2 @(ev?.available_seats == 0 ? "disabled" : "")">
                            @(ev?.available_seats == 0 ? "Ticket Out" : "View Details & Book")
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col">
            <div class="alert alert-info" role="alert">
                There are no upcoming events at the moment. Please check back later!
            </div>
        </div>
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}