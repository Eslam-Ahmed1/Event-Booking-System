@model EventBookingSystem.Models.User
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Register</h2>
                    
                    <form asp-action="register" method="post" id="registerForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="name" class="control-label fw-bold">Name</label>
                            <input asp-for="name" class="form-control" placeholder="Enter your full name" />
                            <span asp-validation-for="name" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="email" class="control-label fw-bold">Email</label>
                            <input asp-for="email" class="form-control" placeholder="Enter your email" type="email" />
                            <span asp-validation-for="email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="password" class="control-label fw-bold">Password</label>
                            <input asp-for="password" type="password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="password" class="text-danger small"></span>
                            <small class="form-text text-muted">Password must be at least 8 characters long</small>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="phone" class="control-label fw-bold">Phone Number</label>
                            <input asp-for="phone" class="form-control" placeholder="Enter your phone number" />
                            <span asp-validation-for="phone" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Register</button>
                        </div>
                    </form>
                    
                    <div class="mt-3 text-center">
                        <p class="mb-0">Already have an account? <a asp-action="login">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- IMPORTANT: Include validation scripts -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    </script>
}