@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Admin Dashboard</h1>
    <p>Welcome, Administrator. Manage your system from here.</p>
</div>

<div class="row mt-5 justify-content-center">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Manage Events</h5>
                <p class="card-text">Create, edit, and delete events.</p>
                <a asp-controller="Event" asp-action="Index" class="btn btn-primary">Go to Events</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">View All Bookings</h5>
                <p class="card-text">Monitor and manage all user bookings.</p>
                <a asp-controller="Admin" asp-action="Bookings" class="btn btn-primary">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Manage Users</h5>
                <p class="card-text">View and manage registered users.</p>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-primary">View Users</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>System Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <h3>@ViewBag.TotalEvents</h3>
                        <p>Total Events</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3>@ViewBag.TotalBookings</h3>
                        <p>Total Bookings</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3>@ViewBag.TotalUsers</h3>
                        <p>Registered Users</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h3>@ViewBag.TotalRevenue</h3>
                        <p>Revenue (if paid)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>