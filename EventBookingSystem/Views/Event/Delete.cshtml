@model EventBookingSystem.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <h4>Event</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.title)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.title)
        </dd>
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.date)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.date)
        </dd>
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.location)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.location)
        </dd>
        <dt class = "col-sm-3">
            @Html.DisplayNameFor(model => model.total_seats)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.total_seats)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="event_id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>